config QSFWSZ
	bool "QSFWSZ kernel diagnostic interface"
	select MISC_DEVICES
	default n
	help
	  Build the QSFWSZ diagnostic miscdevice at /dev/qsfwsz.
	  The current ABI exposes driver metadata only. It does not provide
	  cross-process memory access or memory modification.
